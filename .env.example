# Copy this file to .env and fill in your values.

# ---------------------------------------------------------------------------
# LLM backend (required)
# ---------------------------------------------------------------------------

# OpenAI-compatible endpoint (e.g. vLLM, Ollama, Azure OpenAI)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=gpt-oss-120b
OPENAI_API_KEY=your-local-api-key-here

# Or use Google Gemini via Vertex AI (requires ADC: gcloud auth application-default login)
# GEMINI_PROJECT_ID=your-gcp-project-id
# GEMINI_LOCATION=us-central1
# GEMINI_MODEL=gemini-3.1-pro-preview

# ---------------------------------------------------------------------------
# Database (optional override)
# ---------------------------------------------------------------------------

# Default: src/database/synthetic.sqlite
# DB_PATH=src/database/synthetic.sqlite

# ---------------------------------------------------------------------------
# Agent behaviour (optional)
# ---------------------------------------------------------------------------

# Maximum tool-use rounds per question (default: 8)
# MAX_TOOL_ROUNDS=8

# Language for generated answers (default: English)
# ANSWER_LANGUAGE=English

# Context token limit — keep headroom for system prompt + skills (default: 120000)
# VLLM_CONTEXT_TOKENS=120000

# Sampling temperature (omit to use model default)
# VLLM_TEMPERATURE=0.0

# Max tokens per completion
# VLLM_MAX_COMPLETION_TOKENS=4096

# LiteLLM priority queue tier: priority | normal | background
# VLLM_SERVICE_TIER=normal

# Enable hybrid BM25+embedding retrieval (default: BM25 only)
# USE_HYBRID_RETRIEVAL=0

# ---------------------------------------------------------------------------
# API server for GUI (optional, only needed when running src/api_server.py)
# ---------------------------------------------------------------------------

# AGENT_HOST=0.0.0.0
# AGENT_PORT=8765

# ---------------------------------------------------------------------------
# Web UI (only needed when running src/clinical-rag-ui with npm run dev)
# ---------------------------------------------------------------------------

# URL of the running API server as seen from the Vite dev server host.
# The dev proxy forwards /api/* requests here, so CORS is never an issue.
# AGENT_API_URL=http://localhost:8000
